<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
        <PackageReference Include="PostHog.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common.Library.Api\Common.Library.Api.csproj"/>
        <ProjectReference Include="..\Common.Library.Logging\Common.Library.Logging.csproj"/>
        <ProjectReference Include="..\Sample.Application\Sample.Application.csproj"/>
        <ProjectReference Include="..\WebProject.ServiceDefaults\WebProject.ServiceDefaults.csproj"/>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <PropertyGroup>
        <OpenApiGenerateDocumentsOptions>--document-name v1 --openapi-version OpenApi3_0</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

</Project>
