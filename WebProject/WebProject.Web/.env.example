# WebProject.Web — environment variables
# Copy this file to .env.local and adjust values for your local setup.
# .env.local is git-ignored — never commit real values.
#
# When running via Aspire (dotnet run --project WebProject.AppHost),
# VITE_API_BASE_URL is injected automatically — you do not need to set it here.
# Only set it when running the frontend standalone (npm run dev without Aspire).

VITE_API_BASE_URL=http://localhost:5000
